{
  "version": 2,
  "builds": [
    {
      "src": "11_v2_deployment/api/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/11_v2_deployment/api/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "/11_v2_deployment/public/$1"
    }
  ],
  "functions": {
    "11_v2_deployment/api/main.py": {
      "maxDuration": 30
    }
  },
  "env": {
    "OPENAI_API_KEY": "@openai_api_key",
    "COHERE_API_KEY": "@cohere_api_key"
  }
}
